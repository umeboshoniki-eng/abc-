import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

PAGE_SIZE = 40


def api_call(url, method="GET"):
    req = urllib.request.Request(url, method=method)
    req.add_header("User-Agent", "ScratchStudioGuard/1.0")

    if SESSION_ID:
        req.add_header("Cookie", f"scratchsessionsid={SESSION_ID};")
        req.add_header("X-Requested-With", "XMLHttpRequest")
        req.add_header(
            "Referer",
            f"https://scratch.mit.edu/studios/{STUDIO_ID}/"
        )

    try:
        with urllib.request.urlopen(req, timeout=8) as res:
            body = res.read()

            if method == "GET":
                return json.loads(body.decode("utf-8"))

            return 200 <= res.status < 300

    except urllib.error.HTTPError as e:
        print(f"[HTTP {e.code}] {method} {url}", file=sys.stderr)
    except (urllib.error.URLError, TimeoutError) as e:
        print(f"[Network error] {e}", file=sys.stderr)
    except json.JSONDecodeError as e:
        print(f"[Invalid JSON] {e}", file=sys.stderr)

    return None


def get_all(endpoint):
    results = []
    offset = 0

    while True:
        url = (
            f"https://api.scratch.mit.edu/{endpoint}"
            f"?limit={PAGE_SIZE}&offset={offset}"
        )
        page = api_call(url)

        if not isinstance(page, list):
            break

        results.extend(page)

        if len(page) < PAGE_SIZE:
            break

        offset += PAGE_SIZE

    return results


def run_guard():
    failed = False

    print(
        f"Scanning studio #{STUDIO_ID} "
        f"({len(BLOCKED_SET)} blocked users)..."
    )

    projects = get_all(f"studios/{STUDIO_ID}/projects")

    for project in projects:
        username = (project.get("username") or "").strip().lower()

        if username not in BLOCKED_SET:
            continue

        project_id = project.get("id")
        print(f"[REMOVED] Project #{project_id} by @{username}")

        if SESSION_ID:
            ok = api_call(
                f"https://api.scratch.mit.edu/studios/"
                f"{STUDIO_ID}/project/{project_id}",
                method="DELETE",
            )
            failed |= ok is not True

    curators = get_all(f"studios/{STUDIO_ID}/curators")

    for curator in curators:
        username = (curator.get("username") or "").strip()

        if username.lower() not in BLOCKED_SET:
            continue

        encoded_username = urllib.parse.quote(username, safe="")
        print(f"[KICKED] Curator @{username}")

        if SESSION_ID:
            ok = api_call(
                f"https://api.scratch.mit.edu/studios/{STUDIO_ID}/"
                f"curators/{encoded_username}",
                method="DELETE",
            )
            failed |= ok is not True

    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(run_guard())
